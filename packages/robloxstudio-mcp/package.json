{
  "name": "@chrrxs/robloxstudio-mcp",
  "version": "3.0.5",
  "description": "MCP server for testing, debugging, and controlling Roblox Studio from AI coding tools",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "robloxstudio-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "studio-plugin/MCPPlugin.rbxmx"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack.mjs",
    "postpack": "node ../../scripts/postpack.mjs"
  },
  "keywords": [
    "mcp",
    "roblox",
    "studio",
    "ai",
    "model-context-protocol",
    "game-development"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrrxs/robloxstudio-mcp.git"
  },
  "homepage": "https://github.com/chrrxs/robloxstudio-mcp#readme",
  "bugs": {
    "url": "https://github.com/chrrxs/robloxstudio-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@chrrxs/robloxstudio-mcp-core": "*"
  }
}
